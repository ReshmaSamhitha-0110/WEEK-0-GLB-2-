public class PalindromeNumbers {

    public static void main(String[] args) {
        int N = 200;

        System.out.println("Palindrome numbers less than " + N + ":");

        for (int i = 1; i < N; i++) {
            int num = i;
            int rev = 0;

            while (num > 0) {
                rev = rev * 10 + num % 10;
                num = num / 10;
            }

            if (i == rev) {
                System.out.print(i + " ");
            }
        }
    }
}
